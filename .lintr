linters: linters_with_defaults(
    indentation_linter = NULL,
    line_length_linter = NULL,
    commented_code_linter = NULL,
    brace_linter = NULL,
    semicolon_linter = NULL,
    object_name_linter = object_name_linter(styles = c("snake_case", "dotted.case", "symbols")),
    object_length_linter = object_length_linter(35L),
    cyclocomp_linter = cyclocomp_linter(50L)
  )
exclusions: list("tests/testthat")
